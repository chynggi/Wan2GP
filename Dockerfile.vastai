# Dockerfile.vastai — vast.ai 파생 이미지 (RTX 5090 / sm_120, CUDA 13.0)
#
# vast 공식 파생 이미지(derivatives/pytorch/derivatives/wan2gp)와 동일한 UX:
#   Instance Portal + Caddy(TLS/인증) + Supervisor 상시 실행 + Jupyter + SSH + Syncthing.
# 차이는 베이스가 CUDA 13.0 / torch 2.10.0+cu130 이고, sm_120 커스텀 커널을 추가로
# 빌드한다는 점이다 (SageAttention v2/v3, FlashAttention, comfy-kitchen, nunchaku).
#
# 베이스: vastai/pytorch (vastai/base-image 파생)
#   torch 2.10.0 (cu130 backend), CUDA toolkit 13.0.3, cuDNN 9.14, Python 3.11
#   /venv/main, WORKSPACE=/workspace, user(UID 1001)
#   ENTRYPOINT=/opt/instance-tools/bin/entrypoint.sh  ← 이 파일에서 덮어쓰지 않는다
#
# 앱 코드는 /opt/workspace-internal/Wan2GP 로 클론되고, 베이스 이미지가 첫 부팅 때
# $WORKSPACE(/workspace)/Wan2GP 로 복사한다. 실행은 Supervisor 서비스 wan2gp 가 맡는다.
# (ROOT/ 참고: etc/supervisor/conf.d/wan2gp.conf, opt/supervisor-scripts/wan2gp.sh)
FROM vastai/pytorch:2.10.0-cuda-13.0.3-py311-24.04-2026-09-08

# RTX 50xx(sm_120). 예: --build-arg CUDA_ARCHITECTURES="8.6;12.0"
ARG CUDA_ARCHITECTURES="12.0"
# GHA 표준 러너 4 vCPU 기준. 로컬: --build-arg MAX_JOBS=$(nproc)
ARG MAX_JOBS=4

ENV DEBIAN_FRONTEND=noninteractive \
    TORCH_CUDA_ARCH_LIST="${CUDA_ARCHITECTURES}" \
    FORCE_CUDA="1" \
    MAX_JOBS="${MAX_JOBS}" \
    COMFY_CUDA_ARCHS="120f"

# ── 1. 시스템 의존성 ─────────────────────────────────────────────────
# base 이미지에 git/cmake/ninja 는 있으나 ffmpeg/GL/ALSA 는 보강한다
# (libasound2-dev 는 공식 이미지와 동일하게 SDL 오디오용)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ffmpeg libgl1 libglib2.0-0 libasound2-dev && \
    rm -rf /var/lib/apt/lists/*

# ── 2. Wan2GP 소스 클론 + requirements 설치 ───────────────────────────
# 주의: base 의 python3 는 시스템 3.12 이므로 모든 RUN 에서 /venv/main 을 활성화한다.
# requirements 의 torch 계열 핀은 제거해 베이스 torch 2.10.0+cu130 을 단일 소스로 유지
# (torchcodec 은 upstream 이 어디서도 import 하지 않는 dead dep).
ARG WAN2GP_REPO=https://github.com/chynggi/Wan2GP.git
ARG WAN2GP_REF=main
RUN . /venv/main/bin/activate && \
    python -c "import torch; assert torch.__version__.startswith('2.10.0'), torch.__version__; assert torch.version.cuda.startswith('13'), torch.version.cuda; print('torch', torch.__version__, 'cuda', torch.version.cuda)" && \
    git clone "${WAN2GP_REPO}" /opt/workspace-internal/Wan2GP && \
    cd /opt/workspace-internal/Wan2GP && \
    git checkout "${WAN2GP_REF}" && \
    sed -i -E '/^(torch|torchvision|torchaudio|torchcodec)([[:space:]]|[<>=!])/d' requirements.txt && \
    uv pip install --no-cache-dir -r requirements.txt

# SageAttention v2/v3 및 Wan2GP sage3 모드 모두 Triton 필요 (setup_config triton v37)
RUN . /venv/main/bin/activate && \
    pip install --no-cache-dir "triton>=3.6,<3.7"

# ── 3. torch 헤더 패치: CUDA 13.x nvcc 는 List_inl.h 의 decltype difference_type 을 거부
# (MODIFICATIONS.md/patch-torch-header.sh 참조). torch==2.10.0 고정이므로
# pattern 미일치 = drift → 의도적으로 빌드 실패시킨다
COPY <<EOF /tmp/patch_torch_header.py
import os, sys, torch
p = os.path.join(os.path.dirname(torch.__file__), "include", "ATen", "core", "List_inl.h")
s = open(p).read()
old = "  return {impl_->list.begin() + static_cast<typename decltype(impl_->list)::difference_type>(pos)};"
new = "  return {impl_->list.begin() + static_cast<std::ptrdiff_t>(pos)};"
if new in s:
    print("already patched")
elif old in s:
    open(p, "w").write(s.replace(old, new))
    print("patched List_inl.h")
else:
    sys.exit("List_inl.h pattern not found - torch version changed, re-check manually")
EOF

# ── 4. SageAttention v2 + v3 소스 빌드 (sm_120) ────────────────────────
# v2 는 setup.py 가 TORCH_CUDA_ARCH_LIST 를 직접 읽으므로 패치 불필요 (upstream 확인 완료)
RUN . /venv/main/bin/activate && \
    pip install --no-cache-dir --force-reinstall "setuptools<=75.8.2" ninja wheel && \
    python /tmp/patch_torch_header.py && \
    git clone --depth 1 https://github.com/thu-ml/SageAttention.git /tmp/sageattention && \
    cd /tmp/sageattention && \
    EXT_PARALLEL=1 pip install --no-cache-dir --no-build-isolation . && \
    cd sageattention3_blackwell && \
    python -c "p='setup.py'; s=open(p).read(); o='cc_major, cc_minor = torch.cuda.get_device_capability()'; n='cc_major, cc_minor = (12, 0)  # patched: no GPU in CI, force sm_120a'; assert o in s, 'sage3 setup.py GPU-detection pattern changed'; open(p,'w').write(s.replace(o,n)); print('sage3 setup.py patched -> sm_120a')" && \
    pip install --no-cache-dir --no-build-isolation . && \
    rm -rf /tmp/sageattention

# ── 5. Flash Attention 2.7.2.post1 (docs/INSTALLATION.md Linux pin) ─────
# 2.7.2.post1 의 setup.py 는 TORCH_CUDA_ARCH_LIST 를 무시하고 sm_80/sm_90 gencode 를 하드코딩한다
# (CUDA>=11.8 이면 sm_90 도 추가) → sm_120 커널이 빠진다. sdist 를 받아 gencode 플래그를
# TORCH_CUDA_ARCH_LIST 기반으로 생성하도록 패치한 뒤 --no-build-isolation 으로 빌드한다.
COPY <<'EOF' /tmp/patch_flash_setup.py
import os

with open('setup.py', 'r') as f:
    content = f.read()

arch_list = os.environ.get('TORCH_CUDA_ARCH_LIST')
gencode_lines = []
for arch in arch_list.split(';'):
    major, minor = arch.strip().split('.')
    sm = f"{major}{minor}"
    gencode_lines.append('    cc_flag.append("-gencode")')
    gencode_lines.append(f'    cc_flag.append("arch=compute_{sm},code=sm_{sm}")')
new_block = "\n".join(gencode_lines)

old_block = (
    '    cc_flag.append("-gencode")\n'
    '    cc_flag.append("arch=compute_80,code=sm_80")\n'
    '    if CUDA_HOME is not None:\n'
    '        if bare_metal_version >= Version("11.8"):\n'
    '            cc_flag.append("-gencode")\n'
    '            cc_flag.append("arch=compute_90,code=sm_90")'
)

assert old_block in content, "flash-attn setup.py gencode pattern not found - upstream drift, re-check manually"

content = content.replace(old_block, new_block)

with open('setup.py', 'w') as f:
    f.write(content)

print(f"patched flash-attn setup.py gencode -> {arch_list}")

# Bundled (old) cutlass gates the versioned driver-entry-point path on
# `MAJOR >= 12 && MINOR >= 5`, which is false for CUDA 13.0 and falls back to
# cudaGetDriverEntryPoint + unversioned PFN_* typedefs that CUDA 13 removed.
hdr = 'csrc/cutlass/include/cutlass/cuda_host_adapter.hpp'
with open(hdr, 'r') as f:
    content = f.read()

old_cond = '#if (__CUDACC_VER_MAJOR__ >= 12 && __CUDACC_VER_MINOR__ >= 5)'
new_cond = '#if (__CUDACC_VER_MAJOR__ > 12 || (__CUDACC_VER_MAJOR__ == 12 && __CUDACC_VER_MINOR__ >= 5))'

assert content.count(old_cond) == 1, "cutlass cuda_host_adapter.hpp version-check pattern not found - upstream drift, re-check manually"

with open(hdr, 'w') as f:
    f.write(content.replace(old_cond, new_cond))

print("patched bundled cutlass cuda_host_adapter.hpp CUDA 13 version check")
EOF

# `pip download --no-binary :all:` would build sdist metadata in an isolated env where
# flash-attn's setup.py does `import torch` at module scope and fails (no torch there) ->
# fetch the sdist directly from PyPI's file host instead.
RUN . /venv/main/bin/activate && \
    mkdir -p /tmp/flash-attn-src && \
    curl -fsSL -o /tmp/flash-attn-src/flash_attn-2.7.2.post1.tar.gz \
      https://files.pythonhosted.org/packages/source/f/flash-attn/flash_attn-2.7.2.post1.tar.gz && \
    tar -xzf /tmp/flash-attn-src/flash_attn-2.7.2.post1.tar.gz -C /tmp/flash-attn-src && \
    cd /tmp/flash-attn-src/flash_attn-2.7.2.post1 && \
    python /tmp/patch_flash_setup.py && \
    FLASH_ATTENTION_FORCE_BUILD=TRUE pip install --no-cache-dir --no-build-isolation . && \
    rm -rf /tmp/flash-attn-src

# ── 6. Comfy Kitchen: sm120 네이티브 소스 빌드 ─────────────────────────
# NVFP4(+Blackwell) 에는 [cublas] extra 가 필요 (PyPI comfy-kitchen 문서)
# nanobind>=2.0.0 / cmake>=3.26 는 pyproject 빌드 요구사항이지만 --no-build-isolation 이라
# 미리 설치해둬야 한다. "120f" 는 NVFP4 에 필요한 family-specific target.
RUN . /venv/main/bin/activate && \
    pip install --no-cache-dir "nanobind>=2.0.0" "cmake>=3.26" && \
    pip uninstall -y comfy-kitchen && \
    pip install --no-cache-dir --no-build-isolation "comfy-kitchen[cublas] @ git+https://github.com/Comfy-Org/comfy-kitchen.git" && \
    python -c "from importlib.metadata import version; from packaging.version import Version; v=version('comfy-kitchen'); assert Version(v) >= Version('0.2.35'), v; print('comfy-kitchen', v, '(sm120 source build)')"

# ── 7. 사전 빌드 커널 휠: Lightx2v NVP4 + Nunchaku (RTX 50xx / sm120) ──
RUN . /venv/main/bin/activate && \
    pip install --no-cache-dir \
      https://github.com/deepbeepmeep/kernels/releases/download/Light2xv/lightx2v_kernel-0.0.2+torch2.10.0-cp311-abi3-linux_x86_64.whl && \
    pip install --no-cache-dir \
      https://github.com/nunchaku-ai/nunchaku/releases/download/v1.2.1/nunchaku-1.2.1+cu13.0torch2.10-cp311-cp311-linux_x86_64.whl

# ── 8. 최종 검증 (GPU 없이 실패해야 할 것이 멀쩡히 통과 못하게) ──────────
# libcuda.so.1 는 빌드 환경에 없음 (stubs 디렉터리엔 libcuda.so 뿐) → 임시 심볼릭
# 링크로 dlopen 을 우회하고, 검증이 끝나면 같은 RUN 안에서 제거한다.
RUN . /venv/main/bin/activate && \
    pip show flash-attn sageattention sageattn3 comfy-kitchen lightx2v_kernel nunchaku > /dev/null && \
    mkdir -p /tmp/cuda-stub-shim && \
    ln -sf /usr/local/cuda/lib64/stubs/libcuda.so /tmp/cuda-stub-shim/libcuda.so.1 && \
    LD_LIBRARY_PATH=/tmp/cuda-stub-shim:/usr/local/cuda/lib64/stubs python -c "\
import torch, sageattention, sageattn3, flash_attn, comfy_kitchen; \
assert torch.__version__.startswith('2.10.0') and torch.version.cuda.startswith('13'); \
print('ALL KERNEL IMPORTS OK:', torch.__version__, torch.version.cuda)" && \
    rm -rf /tmp/cuda-stub-shim

# ── 9. Instance Portal / Supervisor 오버레이 (공식 파생 이미지와 동일) ──
# ROOT/ 는 vast-ai/base-image 의 derivatives/pytorch/derivatives/wan2gp/ROOT 를
# 그대로 vendoring 한 것. wan2gp.sh 에만 LD_LIBRARY_PATH unset 을 추가했다.
COPY ROOT /
